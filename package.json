{
  "name": "nodra-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "scripts": {
    "cli": "pnpm --filter nodra cli",
    "new:app": "pnpm --filter nodra cli create",
    "dev": "pnpm --filter myshop dev",
    "build": "pnpm --filter myshop build",
    "start": "pnpm --filter myshop start",
    "new:doctype": "pnpm --filter myshop cli new:doctype",
    "migrate": "pnpm --filter myshop cli migrate",
    "console": "pnpm --filter myshop cli console",
    "typecheck": "pnpm --filter '*' typecheck",
    "lint": "pnpm --filter '*' lint",
    "new:server-fn": "pnpm --filter myshop cli new:server-fn",
    "test": "pnpm --filter '*' test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}