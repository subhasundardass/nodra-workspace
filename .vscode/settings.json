{
  // Editor settings
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.rulers": [100],
  "editor.wordWrap": "off",

  // File associations
  "files.associations": {
    "*.json": "jsonc"
  },

  // Search settings
  "search.exclude": {
    "node_modules": true,
    "dist": true,
    "coverage": true,
    "*.tsbuildinfo": true,
    ".worktrees": true,
    "worktrees": true
  },

  // Files to exclude from explorer
  "files.exclude": {
    "node_modules": true,
    "dist": true,
    "coverage": true,
    "*.tsbuildinfo": true
  },

  // ESLint settings
  "eslint.workingDirectories": ["."],
  "eslint.validate": ["typescript"],

  // Test settings
  "vitest.enable": true,
  "vitest.commandLine": "pnpm test",

  // Git settings
  "git.ignoreLimitWarning": true,

  // Terminal settings
  "terminal.integrated.cwd": "${workspaceFolder}"
}
