# Database
NODRA_DB_HOST=localhost
NODRA_DB_PORT=5432
NODRA_DB_DATABASE=nodra
NODRA_DB_USER=postgres
NODRA_DB_PASSWORD=
NODRA_DB_POOL_MIN=2
NODRA_DB_POOL_MAX=10

# Auth
NODRA_AUTH_SECRET=change-me
NODRA_AUTH_TOKEN_EXPIRY=24h

# Logging
NODRA_LOGGING_LEVEL=info
NODRA_LOGGING_FORMAT=pretty

# TanStack Start dev/preview server port (see vite.config.ts).
# Production host/port for `node .output/server/index.mjs` also read PORT.
PORT=3000
