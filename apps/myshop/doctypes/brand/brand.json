{
  "name": "Brand",
  "module": "App",
  "naming_rule": "field",
  "naming_field": "title",
  "is_submittable": false,
  "is_child": false,
  "is_single": false,
  "is_tree": false,
  "is_virtual": false,
  "title_field": "title",
  "search_fields": [
    "title"
  ],
  "fields": [
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "label": "Title",
      "reqd": true,
      "unique": true,
      "max_length": 140,
      "in_list_view": true
    },
    {
      "fieldname": "brand_type",
      "fieldtype": "Select",
      "label": "Brand Type",
      "options": [
        "Factory",
        "Company"
      ],
      "default": "Factory",
      "reqd": true,
      "in_list_view": true
    },
    {
      "fieldname": "is_active",
      "fieldtype": "Check",
      "label": "Is Active",
      "default": "1",
      "in_list_view": true
    },
    {
      "fieldname": "description",
      "fieldtype": "SmallText",
      "label": "Description",
      "reqd": false
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}