# Database
NODRA_DB_HOST=localhost
NODRA_DB_PORT=5432
NODRA_DB_DATABASE=tea
NODRA_DB_USER=postgres_user
NODRA_DB_PASSWORD=password
NODRA_DB_POOL_MIN=2
NODRA_DB_POOL_MAX=10

# ==========================================
# Authentication
# ==========================================
NODRA_AUTH_SECRET=replace-with-a-long-random-secret
NODRA_AUTH_TOKEN_EXPIRY=24h
SESSION_PREFIX=nodra

# ==========================================
# Permissions
# ==========================================
NODRA_CHILD_TABLES=1
NODRA_ENFORCE_PERMISSIONS=1

# ==========================================
# Application Server
# ==========================================
PORT=3000
APP_URL=http://localhost:3000

# ==========================================
# Logging
# ==========================================
NODRA_LOGGING_LEVEL=info
NODRA_LOGGING_FORMAT=pretty

# ==========================================
# Redis (only if required by the application)
# ==========================================
REDIS_URL=redis://127.0.0.1:6380